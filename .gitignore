# 依赖与构建产物
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo

# 环境变量（永远不要提交 API Key）
.env
.env.*
!.env.example

# 测试与覆盖率
coverage/
.nyc_output/

# 加密备份产物 —— 绝对不要提交
*.vault
